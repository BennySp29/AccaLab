# AccaLab Environment Configuration
# Copy to .env and fill in any optional free-tier keys you have.
# Note: AccaLab works out-of-the-box without keys using free football-data.co.uk CSVs,
# fixturedownload.com schedules, and BBC/Sky/Guardian RSS feeds!

# Optional: API-Football (api-sports.io free tier: 100 req/day) for live Bet365 odds, injuries & lineups
API_FOOTBALL_KEY=

# Optional: Google AI Studio (Gemini Flash free tier) for AI-written match summaries
GEMINI_API_KEY=

# Optional: Telegram Bot for value-bet & price-movement alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Friend invite code required when adding a new profile via the UI
ACCALAB_INVITE_CODE=ACCALAB2026

# Flask session / CSRF secret (auto-generated in dev if omitted)
SECRET_KEY=accalab-dev-secret-change-me

# Supabase Cloud Auth & Postgres (public client keys; never put service_role or sb_secret here)
SUPABASE_URL=https://xnvwpwygwhfgvcadlnaf.supabase.co
SUPABASE_ANON_KEY=sb_publishable_mWiD-10wVSFNVhK1tqODKQ_eR_3I1EF
